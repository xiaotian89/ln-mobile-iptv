# 辽宁移动IPTV 配置文件
# 更新YAUTH后执行: docker restart iptv-srv
# YAUTH 格式: <32位hex>#<8位hex>#<deviceId>#<mac>#<appVersion>#<appVersionCode>#<deviceType>#V<版本号>.0
YAUTH=在此填入你的YAUTH
HTTP_PORT=8100
EPG_DAYS=3

# EPG 自动更新 cron 表达式（默认每2天 05:00）
EPG_CRON=0 5 */2 * *

# === 抓包 Web 管理界面（可选）===
# 设为 true 启用抓包管理界面，访问 http://<NAS_IP>:8101
ENABLE_CAPTURE_WEB=false
WEB_PORT=8101
# 抓包网口配置的 IP（机顶盒网关）
CAPTURE_IP=192.168.10.1
